# Local Docker configuration. Generate real values with: node scripts/configure-local.mjs
POSTGRES_PASSWORD=replace-with-a-random-hex-string
SETUP_KEY=replace-with-a-random-key-of-at-least-32-characters
APP_ORIGIN=http://localhost:4173
# DATABASE_URL for a host development server only; production uses the internal Coolify URL.
# DATABASE_URL=postgresql://pulso:password@127.0.0.1:5432/pulso
